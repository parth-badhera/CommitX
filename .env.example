# ─────────────────────────────────────────────────────────────
# CommitX environment — copy to .env and fill in.
# Run `npm run check:env` to verify before deploying.
# Never commit .env or share private keys.
# ─────────────────────────────────────────────────────────────

# ── Network (public) ─────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Contract addresses live in src/config/deployments.js (written by the deploy script)
# Public URL of the site (used for share links & metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server secrets (REQUIRED in production) ──────────────────
# Signs EIP-712 settlements and private invites. Its address must equal the
# contract's protocolAttestor.
PROTOCOL_ATTESTOR_PRIVATE_KEY=
# Signs wallet-session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Server-side RPC (falls back to NEXT_PUBLIC_RPC_URL)
SEPOLIA_RPC_URL=

# ── Database ─────────────────────────────────────────────────
# SQLite (local dev / Docker with a volume):
DATABASE_URL="file:./dev.db"

# ── Google sign-in via Supabase (optional — demo login works without it) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Display only ─────────────────────────────────────────────
NEXT_PUBLIC_PROTOCOL_ATTESTOR_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# ── Contract deployment (Hardhat scripts only) ───────────────
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
