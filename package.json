{
  "name": "commitx",
  "version": "1.0.0",
  "private": true,
  "description": "CommitX — Web3 Accountability & Staking Platform",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https",
    "build": "prisma generate && next build",
    "start": "next start",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed.js",
    "manual:pdf": "node scripts/manual/build-manual.js",
    "docs:pdf": "node scripts/techdoc/build-techdoc.js",
    "postinstall": "prisma generate",
    "check:env": "node scripts/check-env.js",
    "db:clean": "node scripts/clean_db.js",
    "db:reset": "node scripts/clean_db.js --all",
    "db:export": "node scripts/db-transfer.js export",
    "db:import": "node scripts/db-transfer.js import",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "dependencies": {
    "@metamask/sdk": "^0.34.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@prisma/client": "^5.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.37.1",
    "clsx": "^2.1.1",
    "ethers": "^6.12.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "viem": "^2.12.0",
    "wagmi": "^2.9.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.6",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "chai": "^4.3.10",
    "hardhat": "^2.22.4",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
